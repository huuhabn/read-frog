              "raw": "{\n  \"model\": \"gpt-4o\",\n  \"instructions\": \"You are a programming mentor.\",\n  \"input\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"What is the difference between interface and type in TypeScript?\"\n    }\n  ],\n  \"stream\": true\n}"
