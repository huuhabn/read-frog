            "body": {
              "mode": "raw",
              "raw": "{\n  \"contents\": [\n    {\n      \"role\": \"user\",\n      \"parts\": [\n        {\n          \"text\": \"List the 3 key benefits of Event-Driven Architecture.\"\n        }\n      ]\n    }\n  ],\n  \"generationConfig\": {\n    \"temperature\": 0.7,\n    \"maxOutputTokens\": 500\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1beta/models/gemini-1.5-flash:streamGenerateContent",
              "host": ["{{baseUrl}}"],
              "path": ["v1beta", "models", "gemini-1.5-flash:streamGenerateContent"]
