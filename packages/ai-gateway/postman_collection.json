    {
      "name": "Prompt Pipeline & Orchestrator",
      "item": [
        {
          "name": "Pipeline - Chat & Translation (Cache Miss & Normalization)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{apiKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Please translate this sentence: AI Gateway is powerful with <b>HTML markers</b> and $E=mc^2$.\",\n  \"target\": \"openai/gpt-4o\",\n  \"styleProfile\": {\n    \"targetLanguage\": \"Vietnamese\",\n    \"tone\": \"professional and concise\",\n    \"glossary\": {\n      \"AI Gateway\": \"Cổng kết nối AI\"\n    }\n  },\n  \"params\": {\n    \"temperature\": 0.3\n  },\n  \"bypassCache\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/chat/pipeline",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "chat", "pipeline"]
            },
            "description": "Executes the 10-step Prompt Pipeline lifecycle: Resolves base rules & styleProfile, extracts matched glossary, activates conditional layers (HTML & Math), safe-interpolates template variables, executes inference via fallback router, normalizes output (stripping <think> and validating markers), saves to Cache and records audit logs."
          }
        },
        {
          "name": "Pipeline - Cache Hit Verification (Zero-Latency)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{apiKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Please translate this sentence: AI Gateway is powerful with <b>HTML markers</b> and $E=mc^2$.\",\n  \"target\": \"openai/gpt-4o\",\n  \"styleProfile\": {\n    \"targetLanguage\": \"Vietnamese\",\n    \"tone\": \"professional and concise\",\n    \"glossary\": {\n      \"AI Gateway\": \"Cổng kết nối AI\"\n    }\n  },\n  \"params\": {\n    \"temperature\": 0.3\n  },\n  \"bypassCache\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/chat/pipeline",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "chat", "pipeline"]
            },
            "description": "Repeats identical prompt pipeline call. Verifies that result is served instantly from L3 deterministic SHA-256 Cache with cached: true and zero upstream cost."
          }
        },
        {
          "name": "Pipeline - Streaming SSE with On-the-Fly Normalization",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{apiKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Explain why Clean Architecture matters in AI applications in 2 sentences.\",\n  \"target\": \"openai/gpt-4o\",\n  \"stream\": true,\n  \"styleProfile\": {\n    \"tone\": \"concise\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/chat/pipeline",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "chat", "pipeline"]
            },
            "description": "Streams output chunks in real-time via Server-Sent Events (SSE). Chunks pass through the TransformStream normalizer to suppress reasoning <think> blocks on the fly."
          }
        }
      ]
    }
  ]
}
