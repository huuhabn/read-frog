            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"claude-3-5-haiku-20241022\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Hello Claude! Give me 3 tips for writing clean code.\"\n    }\n  ],\n  \"max_tokens\": 500,\n  \"stream\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/messages",
